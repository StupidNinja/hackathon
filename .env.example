# Frontend environment variables
# VITE_* values are exposed to the browser. Do not put server-only secrets here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional. If not set, app uses {window.origin}/auth/callback
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
VITE_RULES_PUBLIC_URL=
VITE_RULES_BUCKET=public
VITE_RULES_FILE_PATH=polozhenie.pdf

# Supabase CLI — used by `npm run db:push` and other supabase CLI commands
# Find these in: Supabase Dashboard → Project Settings → Database → Connection string
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# SMTP (used by Edge Function notify_rejection)
SMTP_HOSTNAME=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
